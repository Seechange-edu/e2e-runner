{
  "profiles": [
    {
      "id": "tns-frontend",
      "owner": "Seechange-edu",
      "repo": "think-and-speak-frontend",
      "statusContext": "e2e/release-gate",
      "runtime": "playwright",
      "container": "mcr.microsoft.com/playwright:v1.57.0-jammy",
      "timeoutMinutes": 90,
      "shards": 3,
      "concurrencyGroup": "e2e-tns-frontend",
      "probeUrl": "https://uat-app-api.thinkandspeak.com/",
      "install": "yarn install --frozen-lockfile",
      "yarnCache": "yarn.lock",
      "plan": "node scripts/run-affected.mjs --plan",
      "commandAffected": "node scripts/run-affected.mjs --built --trace=retain-on-failure",
      "commandAll": "node scripts/run-affected.mjs --built --trace=retain-on-failure --run-all",
      "secretEnv": [
        "E2E_ACCOUNT_PASSWORD"
      ],
      "env": {
        "E2E_ENV": "uat"
      },
      "manual": {
        "statusContext": "manual/user-manual",
        "timeoutMinutes": 60,
        "envFile": "env/prod.env",
        "command": "yarn manual",
        "build": "node scripts/build-manual.mjs --version",
        "asset": "manual-output/ThinkAndSpeak-User-Manual-{tag}.pdf",
        "deployRepo": "Seechange-edu/act-speaking-exercise-frontend",
        "deployPrefix": "think-and-speak-frontend/"
      }
    }
  ]
}
