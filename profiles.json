{
  "profiles": [
    {
      "id": "tns-frontend",
      "owner": "Seechange-edu",
      "repo": "think-and-speak-frontend",
      "statusContext": "e2e/release-gate",
      "runtime": "playwright",
      "container": "mcr.microsoft.com/playwright:v1.57.0-jammy",
      "timeoutMinutes": 75,
      "concurrencyGroup": "e2e-tns-frontend",
      "shards": 1,
      "probeUrl": "https://uat-app-api.thinkandspeak.com/",
      "requireReleaseRef": true,
      "install": "yarn install --frozen-lockfile",
      "commandAffected": "node scripts/run-affected.mjs --release --built --trace=off",
      "commandAll": "node scripts/run-affected.mjs --release --built --trace=off --run-all",
      "secretEnv": [
        "E2E_ACCOUNT_PASSWORD"
      ],
      "env": {
        "E2E_ENV": "uat"
      }
    }
  ]
}
